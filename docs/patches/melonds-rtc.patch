+// --- libretro-rollback: frontend-routed local wireless ------------------------------------------
+// Linked netplay runs one console per process, so the broadcast socket is not enough: the peer's
+// radio packets must be delivered at an emulated frame boundary, otherwise the two consoles see
+// different radio timing and drift apart. When the frontend installs these callbacks the MP radio
+// routes through it and no socket is opened (two linked instances may share a machine).
+// See libretro-rollback's docs/two-console.md.
+typedef int (*t6_link_send_fn)(const u8* data, int len);
+typedef int (*t6_link_recv_fn)(u8* data, int len);
+
+static t6_link_send_fn t6_link_send_cb = NULL;
+static t6_link_recv_fn t6_link_recv_cb = NULL;
+
+extern "C" void t6_link_set_callbacks(t6_link_send_fn send, t6_link_recv_fn recv)
+{
+   t6_link_send_cb = send;
+   t6_link_recv_cb = recv;
+   if ((send || recv) && MPSocket != INVALID_SOCKET)
+   {
+      closesocket(MPSocket);
+      MPSocket = INVALID_SOCKET;
+   }
+}

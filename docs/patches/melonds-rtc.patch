+// --- libretro-rollback: dirty pages of the serialized state --------------------------------
+// The rollback delta ring can skip its page scan when the core reports which 4 KiB pages of the
+// serialized buffer changed since the previous save. Both peers must use this patched build; the
+// symbol is optional for the frontend (a stock core does not export it).
+static uint8_t* t6_prev_state = NULL;
+static size_t t6_prev_size = 0;
+static uint8_t* t6_dirty_pages = NULL;
+static size_t t6_dirty_count = 0;
+static int t6_dirty_valid = 0;
+
+extern "C" size_t t6_rollback_dirty_pages(uint8_t* out, size_t pages)
+{
+   if (!out || !t6_dirty_valid || pages < t6_dirty_count)
+      return 0;
+   std::memcpy(out, t6_dirty_pages, t6_dirty_count);
+   return t6_dirty_count;
+}
+
+static void t6_track_dirty(const uint8_t* data, size_t size)
+{
+   const size_t pages = (size + 4095) / 4096;
+
+   if (!t6_prev_state || t6_prev_size < size)
+   {
+      std::free(t6_prev_state);
+      t6_prev_state = (uint8_t*)std::malloc(pages * 4096);
+      t6_prev_size = size;
+      t6_dirty_valid = 0;
+   }
+   if (!t6_dirty_pages || t6_dirty_count < pages)
+   {
+      std::free(t6_dirty_pages);
+      t6_dirty_pages = (uint8_t*)std::malloc(pages);
+      t6_dirty_count = pages;
+   }
+
+   for (size_t page = 0; page < pages; page++)
+   {
+      const size_t offset = page * 4096;
+      const size_t length = (offset + 4096 <= size) ? 4096 : (size - offset);
+      t6_dirty_pages[page] = (!t6_dirty_valid ||
+         std::memcmp(data + offset, t6_prev_state + offset, length) != 0) ? 1 : 0;
+   }
+   std::memcpy(t6_prev_state, data, size);
+   t6_prev_size = size;
+   t6_dirty_valid = 1;
+}
+
 bool retro_serialize(void *data, size_t size)
 {
    if (NDS::ConsoleType == 0)
    {
       Savestate* savestate = new Savestate(data, size, true);
       NDS::DoSavestate(savestate);
+      const size_t written = savestate->GetOffset();
       delete savestate;
+      t6_track_dirty((const uint8_t*)data, written);
 
       return true;
    }
@@ -987,6 +1040,9 @@ bool retro_unserialize(const void *data, size_t size)
 {
    if (NDS::ConsoleType == 0)
    {
+      // The tracking baseline no longer matches the machine after a load: the next save marks every
+      // page dirty, which is conservative and correct.
+      t6_dirty_valid = 0;
       Savestate* savestate = new Savestate((void*)data, size, false);
       NDS::DoSavestate(savestate);
       delete savestate;

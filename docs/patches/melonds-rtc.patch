+// --- libretro-rollback: link ABI diagnostic -----------------------------------------------------
+// Round-trips a probe through the very routing MP_SendPacket / MP_RecvPacket use, so an integration
+// test can prove the frontend callbacks are wired without needing a game that is inside a local
+// wireless screen. Returns bit 0 when the radio transmitted the probe, bit 1 when the radio received
+// it back, and 0 when no callbacks are installed. See libretro-rollback's docs/two-console.md.
+extern "C" int t6_link_selftest()
+{
+   static const u8 probe[4] = { 0x54, 0x36, 0x4C, 0x4B }; // "T6LK"
+   u8 buffer[2048];
+   int result = 0;
+
+   if (Platform::MP_SendPacket((u8*)probe, 4) == 4)
+      result |= 1;
+
+   int length = Platform::MP_RecvPacket(buffer, false);
+   if (length == 4 && memcmp(buffer, probe, 4) == 0)
+      result |= 2;
+
+   return result;
+}
